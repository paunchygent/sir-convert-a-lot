# Ignore the entire repo by default and explicitly whitelist the service-image
# build context so code-only deploys send the smallest possible payload to
# BuildKit.
*

!.git
.git/*
!.git/HEAD
!.git/refs
!.git/refs/**
!.git/packed-refs

!docker
docker/*
!docker/service-deps
!docker/service-deps/**

!containers
containers/*
!containers/qwen-finetune-hemma
!containers/qwen-finetune-hemma/requirements.txt

!scripts
scripts/*

!scripts/__init__.py
!scripts/devops
scripts/devops/*
!scripts/devops/qwen_finetuning_patches
!scripts/devops/qwen_finetuning_patches/**
!scripts/sir_convert_a_lot
scripts/sir_convert_a_lot/*

!scripts/sir_convert_a_lot/__init__.py
!scripts/sir_convert_a_lot/service.py
!scripts/sir_convert_a_lot/service_remote_proof.py
!scripts/sir_convert_a_lot/service_local.py
!scripts/sir_convert_a_lot/application
!scripts/sir_convert_a_lot/application/**
!scripts/sir_convert_a_lot/domain
!scripts/sir_convert_a_lot/domain/**
!scripts/sir_convert_a_lot/infrastructure
!scripts/sir_convert_a_lot/infrastructure/**
!scripts/sir_convert_a_lot/integrations
!scripts/sir_convert_a_lot/integrations/**
!scripts/sir_convert_a_lot/interfaces
!scripts/sir_convert_a_lot/interfaces/**
!scripts/sir_convert_a_lot/ml
!scripts/sir_convert_a_lot/ml/**
!scripts/sir_convert_a_lot/templates
!scripts/sir_convert_a_lot/templates/**
!scripts/sir_convert_a_lot/devops
scripts/sir_convert_a_lot/devops/*
!scripts/sir_convert_a_lot/devops/__init__.py
!scripts/sir_convert_a_lot/devops/audio_transcription_sidecar_runtime_probe.py
!scripts/sir_convert_a_lot/devops/export_service_requirements.py
!scripts/sir_convert_a_lot/devops/service_image_build_contract.py
!scripts/sir_convert_a_lot/stt_sidecar
!scripts/sir_convert_a_lot/stt_sidecar/**
