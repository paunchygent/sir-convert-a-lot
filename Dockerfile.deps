# syntax=docker/dockerfile:1
#
# Purpose:
#   Build hash-addressed Sir Convert-a-Lot service dependency images from
#   generated dependency input artifacts, without copying full pyproject.toml.
#
# Relationships:
#   - Built by scripts/devops/service-deps-image.sh.
#   - Consumed by Dockerfile and Dockerfile.local through explicit DEPS_IMAGE.
#   - Keeps ROCm/CPU torch installs and EasyOCR preload out of app-only builds.
#

ARG PYTHON_IMAGE=python:3.12-slim
ARG DEV_YQ_VERSION=4.53.2

FROM ${PYTHON_IMAGE} AS runtime-base

ARG DEV_YQ_VERSION

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bat \
        bind9-dnsutils \
        ca-certificates \
        curl \
        direnv \
        eza \
        fd-find \
        fzf \
        gawk \
        git \
        git-delta \
        htop \
        iproute2 \
        iputils-ping \
        jq \
        just \
        less \
        libgl1 \
        libglib2.0-0 \
        libharfbuzz-subset0 \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libsm6 \
        libx11-6 \
        libxext6 \
        libxcb1 \
        libxrender1 \
        netcat-openbsd \
        pandoc \
        procps \
        ripgrep \
        shellcheck \
        shfmt \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-swe \
        tmux \
        tree \
        zoxide \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && ln -sf /usr/bin/batcat /usr/local/bin/bat \
    && YQ_ARCH="$(dpkg --print-architecture)" \
    && curl -fsSL "https://github.com/mikefarah/yq/releases/download/v${DEV_YQ_VERSION}/yq_linux_${YQ_ARCH}" -o /usr/local/bin/yq \
    && chmod +x /usr/local/bin/yq

RUN getent group video >/dev/null || groupadd --system video
RUN getent group render >/dev/null || groupadd --system render
RUN mkdir -p /var/lib/sir-convert-a-lot/prod /var/lib/sir-convert-a-lot/local

FROM runtime-base AS deps-base

LABEL org.opencontainers.image.title="sir-convert-a-lot service dependencies"
LABEL org.opencontainers.image.description="Generated service dependency image"

COPY docker/service-deps/service-requirements.txt /tmp/service-requirements.txt

RUN python -m venv "${VIRTUAL_ENV}"
RUN --mount=type=cache,id=sir-convert-a-lot-pip,target=/root/.cache/pip \
    python -m pip install --upgrade pip
RUN --mount=type=cache,id=sir-convert-a-lot-pip,target=/root/.cache/pip \
    python -m pip install --no-deps -r /tmp/service-requirements.txt

FROM deps-base AS rocm-deps

ARG SERVICE_DEPENDENCY_HASH=unknown
ARG SERVICE_RECIPE_HASH=unknown
ARG SERVICE_DEPENDENCY_IMAGE_HASH=unknown

COPY docker/service-deps/rocm-runtime.env /tmp/rocm-runtime.env

RUN --mount=type=cache,id=sir-convert-a-lot-pip-rocm,target=/root/.cache/pip \
    . /tmp/rocm-runtime.env \
    && python -m pip install --upgrade \
        --index-url "${SIR_CONVERT_A_LOT_TORCH_ROCM_INDEX_URL}" \
        "torch==${SIR_CONVERT_A_LOT_TORCH_VERSION}" \
        "torchvision==${SIR_CONVERT_A_LOT_TORCHVISION_VERSION}" \
        "torchaudio==${SIR_CONVERT_A_LOT_TORCHAUDIO_VERSION}"

RUN mkdir -p /opt/easyocr-models \
    && python -c 'import easyocr; easyocr.Reader(["sv", "en"], gpu=False, model_storage_directory="/opt/easyocr-models", download_enabled=True, verbose=False)'

LABEL sir-convert-a-lot.dependency-hash="${SERVICE_DEPENDENCY_HASH}"
LABEL sir-convert-a-lot.recipe-hash="${SERVICE_RECIPE_HASH}"
LABEL sir-convert-a-lot.dependency-image-hash="${SERVICE_DEPENDENCY_IMAGE_HASH}"

FROM deps-base AS cpu-deps

ARG SERVICE_DEPENDENCY_HASH=unknown
ARG SERVICE_RECIPE_HASH=unknown
ARG SERVICE_DEPENDENCY_IMAGE_HASH=unknown

COPY docker/service-deps/cpu-runtime.env /tmp/cpu-runtime.env

RUN --mount=type=cache,id=sir-convert-a-lot-pip-cpu,target=/root/.cache/pip \
    . /tmp/cpu-runtime.env \
    && python -m pip install --upgrade \
        "torch==${SIR_CONVERT_A_LOT_TORCH_VERSION}" \
        "torchvision==${SIR_CONVERT_A_LOT_TORCHVISION_VERSION}" \
        "torchaudio==${SIR_CONVERT_A_LOT_TORCHAUDIO_VERSION}"

RUN mkdir -p /opt/easyocr-models \
    && python -c 'import easyocr; easyocr.Reader(["sv", "en"], gpu=False, model_storage_directory="/opt/easyocr-models", download_enabled=True, verbose=False)'

LABEL sir-convert-a-lot.dependency-hash="${SERVICE_DEPENDENCY_HASH}"
LABEL sir-convert-a-lot.recipe-hash="${SERVICE_RECIPE_HASH}"
LABEL sir-convert-a-lot.dependency-image-hash="${SERVICE_DEPENDENCY_IMAGE_HASH}"
