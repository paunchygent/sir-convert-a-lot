":[{"guid":"3cdf8e0d72d744a39ddb2f72dd51e63b","validations":[]},{"guid":"52df200f69954593be3aa2513c840021","validations":[]},{"guid":"d3d60d674bae4a809d907ee57fce677b","validations":[]}]},{"id":1815527074,"title":"Begrepp","about":"Vanlig celldelning innebär att en kroppscell delar sig och bildar två nya celler. När en cell ska dela sig kopierar _____  sig själva så att arvsmassan fördubblas. Vid celldelningen hamnar hälften av _____  i den ena och hälften i den andra cellen. På så sätt får de båda nya cellerna exakt samma arvsmassa som ursprungscellen.","bodyHTML":"\u003cp\u003eVanlig celldelning innebär att en kroppscell delar sig och bildar två nya celler. När en cell ska dela sig kopierar \u003cspan class=\"dxWordGap fr-inner\" dx-wg-id=\"bda1f71954db4173aeab0c890e654372\" dx-wg-width=\"106\"\u003e\u003c/span\u003e  sig själva så att arvsmassan fördubblas. Vid celldelningen hamnar hälften av \u003cspan class=\"dxWordGap fr-inner\" dx-wg-id=\"0a85254536ac4f76ba34b2c77b73ed5b\" dx-wg-width=\"106\"\u003e\u003c/span\u003e  i den ena och hälften i den andra cellen. På så sätt får de båda nya cellerna exakt samma arvsmassa som ursprungscellen.\u003c/p\u003e","images":[],"maxScore":1,"notes":"","type":3,"matrixAbilityMask":[],"onlineResources":null,"editorVersion":2,"gradingType":1,"blanks":[{"guid":"bda1f71954db4173aeab0c890e654372","validations":[]},{"guid":"0a85254536ac4f76ba34b2c77b73ed5b","validations":[]}]}],"blank":true,"hidden":false,"start":"2026-05-08T11:25:00.677039Z","duration":0,"durationSetting":0,"stop":"0001-01-01T00:00:00Z","isArchived":false,"examStatus":0,"lastOfflineDownload":"2026-05-08T11:25:03.476338245Z","anonymous":true,"encryptionKey":"xjglKQFfzSbqZBMciKn4vKVEEQA5OFBD","isDemo":false,"isQuestionsLoaded":false,"userId":378727021,"organizationId":372487025,"gradingType":0,"gradingMatrixId":0,"gradingMatrix":null,"publishedParts":0,"rightToLeft":false,"created":"2026-05-08T11:25:00.677039Z","modified":"2026-05-08T11:25:0