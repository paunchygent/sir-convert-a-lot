#
# Purpose:
#   Build a CPU-only local development image for Sir Convert-a-Lot so laptop
#   debugging on macOS consumes an explicit CPU dependency image.
#
# Relationships:
#   - Used by `compose.local.yaml` for the explicit local debug lane.
#   - Consumes `DEPS_IMAGE`, normally built by `pdm run dev-deps-cpu-build`.
#   - Copies only local app runtime source after dependencies and EasyOCR
#     preload are already baked.
#

ARG DEPS_IMAGE=sir-convert-a-lot-deps-cpu:local

FROM ${DEPS_IMAGE} AS runtime

ARG SIR_CONVERT_A_LOT_SERVICE_REVISION=unknown
ARG SIR_CONVERT_A_LOT_EXPECTED_REVISION=unknown

COPY .git /tmp/sir-convert-build-git

RUN set -eu; \
    mkdir -p /opt/sir-convert-a-lot; \
    revision="${SIR_CONVERT_A_LOT_SERVICE_REVISION}"; \
    if [ -z "${revision}" ] || [ "${revision}" = "unknown" ]; then \
      head_ref="$(cat /tmp/sir-convert-build-git/HEAD)"; \
      case "${head_ref}" in \
        "ref: "*) \
          ref_path="${head_ref#ref: }"; \
          if [ -f "/tmp/sir-convert-build-git/${ref_path}" ]; then \
            revision="$(cat "/tmp/sir-convert-build-git/${ref_path}")"; \
          else \
            revision="$(awk -v ref="${ref_path}" '$2 == ref { print $1; exit }' /tmp/sir-convert-build-git/packed-refs)"; \
          fi; \
          ;; \
        *) revision="${head_ref}" ;; \
      esac; \
    fi; \
    expected_revision="${SIR_CONVERT_A_LOT_EXPECTED_REVISION}"; \
    if [ -z "${expected_revision}" ] || [ "${expected_revision}" = "unknown" ]; then \
      expected_revision="${revision}"; \
    fi; \
    printf "%s" "${revision:-unknown}" > /opt/sir-convert-a-lot/service_revision; \
    printf "%s" "${expected_revision:-unknown}" > /opt/sir-convert-a-lot/expected_revision; \
    rm -rf /tmp/sir-convert-build-git

COPY scripts/__init__.py ./scripts/__init__.py
COPY scripts/sir_convert_a_lot/__init__.py ./scripts/sir_convert_a_lot/__init__.py
COPY scripts/sir_convert_a_lot/service_local.py ./scripts/sir_convert_a_lot/service_local.py
COPY scripts/sir_convert_a_lot/application ./scripts/sir_convert_a_lot/application
COPY scripts/sir_convert_a_lot/domain ./scripts/sir_convert_a_lot/domain
COPY scripts/sir_convert_a_lot/infrastructure ./scripts/sir_convert_a_lot/infrastructure
COPY scripts/sir_convert_a_lot/integrations ./scripts/sir_convert_a_lot/integrations
COPY scripts/sir_convert_a_lot/interfaces ./scripts/sir_convert_a_lot/interfaces
COPY scripts/sir_convert_a_lot/templates ./scripts/sir_convert_a_lot/templates

EXPOSE 8085

CMD ["uvicorn", "scripts.sir_convert_a_lot.service_local:app", "--host", "0.0.0.0", "--port", "8085"]
